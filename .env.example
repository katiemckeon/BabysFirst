# Copy this file to .env (git-ignored) and fill in the values. Never commit .env.

# ElevenLabs, used by the muse skill to turn recorded takes into narration
ELEVENLABS_API_KEY=

# Optional: Claude Code, used by `task claude`. Leave unset to use your signed-in Claude account;
# when set, usage is billed to this key instead.
# ANTHROPIC_API_KEY=

# Only if Unity is not in Unity Hub's default install location
# UNITY_EDITOR=
